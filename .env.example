# Variables de entorno de Vite (prefijo VITE_ obligatorio)

# Base URL de la API.
#
# En desarrollo déjalo sin definir: se usa "/api" y el proxy de vite.config.ts
# reenvía las peticiones a http://localhost:5259, así no hay que tocar CORS.
#
# En producción apunta al origen real de la API, p. ej.:
# VITE_API_BASE_URL=https://api.ejemplo.com/api
# VITE_API_BASE_URL=http://localhost:5259/api
#VITE_API_BASE_URL=
